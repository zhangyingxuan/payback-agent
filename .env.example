# 模型后端：gateway（默认）或 codex。Codex 需预先安装并登录 CLI。
#AGENT_LLM_BACKEND=codex
#AGENT_CODEX_COMMAND=codex
#AGENT_CODEX_MODEL=模型名

# gateway 模式的 LLM 网关（OpenAI 兼容 Chat Completions）。三个键缺一不可。
# base_url 填到 /v1 这一层，代码会自己拼 /chat/completions。
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=<密钥>
AGENT_LLM_MODEL=deepseek-chat

# payback-mcp 仓库的位置；默认取与本仓库平级的 ../payback-mcp。
# agent 通过 `uv --directory <这里> run payback-mcp` 以 stdio 拉起它，
# 行情 MCP 保持使用自己的只读数据库账号。
#PAYBACK_MCP_DIR=D:/workspace/github/payback-all/payback-mcp

# 拉起 server 用的命令，默认 uv；换成别的 Python 启动器时改这里。
#PAYBACK_MCP_COMMAND=uv

# 单轮问答里 tool-calling 循环的最大迭代数，默认 8。
#AGENT_MAX_TURNS=8

# Agent 会话与长期偏好的专用 MySQL 写入账号，不要复用行情只读账号。
# 账号需要对目标库具有 CREATE 权限，对三张 agent_* 记忆表具有 SELECT/INSERT/UPDATE/DELETE 权限。
#AGENT_MEMORY_MYSQL_HOST=127.0.0.1
#AGENT_MEMORY_MYSQL_PORT=3306
#AGENT_MEMORY_MYSQL_USER=payback_agent_memory
#AGENT_MEMORY_MYSQL_PASSWORD=替换为专用账号密码
#AGENT_MEMORY_MYSQL_NAME=blowsysun
